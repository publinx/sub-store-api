{
  "name": "@publinx/sub-store-api",
  "version": "2.44.2",
  "description": "A TypeScript API Library for Sub-Store",
  "homepage": "https://github.com/publinx/sub-store-api",
  "license": "MIT",
  "repository": {
    "type": "git",
